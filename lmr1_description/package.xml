<?xml version="1.0"?>
<package format="2">

  <name>lmr1_description</name>
  <version>1.0.0</version>

  <description>
    Robot description, simulation, visualization, SLAM, localization,
    and navigation launch files for the LENNA Mobile Robot 1 (LMR1).
  </description>

  <maintainer email="erf.riazati@gmail.com">Erfan Riazati</maintainer>

  <author email="erf.riazati@gmail.com">Erfan Riazati</author>

  <license>GPLv3</license>

  <!-- ========================================================== -->
  <!-- Build                                                      -->
  <!-- ========================================================== -->

  <buildtool_depend>catkin</buildtool_depend>

  <!-- ========================================================== -->
  <!-- Core Runtime Dependencies                                  -->
  <!-- ========================================================== -->

  <depend>rospy</depend>
  <depend>std_msgs</depend>

  <!-- Robot Description -->
  <depend>xacro</depend>

  <!-- State Publishers -->
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>robot_state_publisher</depend>

  <!-- Visualization -->
  <depend>rviz</depend>

  <!-- Simulation -->
  <depend>gazebo_ros</depend>

  <!-- Teleoperation -->
  <depend>teleop_twist_keyboard</depend>

  <!-- SLAM -->
  <depend>gmapping</depend>

  <!-- Localization -->
  <depend>amcl</depend>
  <depend>map_server</depend>

  <!-- Navigation -->
  <depend>move_base</depend>

  <!-- ========================================================== -->
  <!-- Export                                                     -->
  <!-- ========================================================== -->

  <export>
  </export>

</package>
