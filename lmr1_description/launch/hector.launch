<launch>

  <!-- ========================================================== -->
  <!-- Launch Arguments                                           -->
  <!-- ========================================================== -->

  <!-- Simulation -->
  <arg name="world_name"
       default="$(find turtlebot3_gazebo)/worlds/turtlebot3_world.world"/>

  <arg name="x_pos" default="0.5"/>
  <arg name="y_pos" default="-0.5"/>

  <!-- TF Frames -->
  <arg name="base_frame" default="base_link"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="map_frame" default="map"/>

  <!-- Mapping -->
  <arg name="scan_topic" default="/scan"/>
  <arg name="map_size" default="511"/>
  <arg name="map_start_x" default="0.5"/>
  <arg name="map_start_y" default="0.5"/>

  <!-- Visualization -->
  <arg name="rviz_config"
       default="$(find lmr1_description)/rviz/slam_config.rviz"/>

  <!-- ========================================================== -->
  <!-- Gazebo Simulation                                          -->
  <!-- ========================================================== -->

  <include file="$(find lmr1_description)/launch/gazebo.launch">

    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="x_pos" value="$(arg x_pos)"/>
    <arg name="y_pos" value="$(arg y_pos)"/>

    <arg name="enable_teleop" value="true"/>

  </include>

  <!-- ========================================================== -->
  <!-- SLAM                                                       -->
  <!-- ========================================================== -->

  <node pkg="hector_mapping"
        type="hector_mapping"
        name="hector_mapping"
        output="screen">

    <!-- Frame configuration -->
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>

    <!-- TF configuration -->
    <param name="use_tf_scan_transformation" value="true"/>
    <param name="use_tf_pose_start_estimate" value="false"/>
    <param name="pub_map_odom_transform" value="true"/>

    <!-- Publish scan-matching odometry -->
    <param name="pub_odometry" value="true"/>

    <!-- Map geometry -->
    <param name="map_resolution" value="0.05"/>
    <param name="map_size" value="$(arg map_size)"/>
    <param name="map_size_x" value="$(arg map_size)"/>
    <param name="map_size_y" value="$(arg map_size)"/>

    <!-- Map origin position in normalized coordinates -->
    <param name="map_start_x" value="$(arg map_start_x)"/>
    <param name="map_start_y" value="$(arg map_start_y)"/>

    <param name="map_multi_res_levels" value="4"/>

    <!-- Map update parameters -->
    <param name="update_factor_free" value="0.4"/>
    <param name="update_factor_occupied" value="0.9"/>
    <param name="map_update_distance_thresh" value="0.2"/>
    <param name="map_update_angle_thresh" value="0.9"/>

    <param name="laser_z_min_value" value="-1.0"/>
    <param name="laser_z_max_value" value="1.0"/>
    <param name="laser_max_dist" value="90.0"/>
    <param name="laser_min_dist" value="0.29"/>

    <param name="map_pub_period" value="0.025"/>

    <!-- Topic and service settings -->
    <param name="advertise_map_service" value="true"/>
    <param name="scan_subscriber_queue_size" value="5"/>
    <param name="scan_topic" value="$(arg scan_topic)"/>

  </node>


  <!-- ========================================================== -->
  <!-- Visualization                                              -->
  <!-- ========================================================== -->

  <node name="rviz"
        pkg="rviz"
        type="rviz"
        output="screen"
        args="-d $(arg rviz_config)"/>

</launch>
