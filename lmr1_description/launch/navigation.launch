<launch>

  <!-- ============================= -->
  <!-- Use Gazebo Clock -->
  <!-- ============================= -->
  <param name="use_sim_time" value="true"/>

  <!-- ============================= -->
  <!-- Robot Description -->
  <!-- ============================= -->
  <param name="robot_description"
         command="$(find xacro)/xacro $(find lmr1_description)/urdf/robot.urdf.xacro"/>

  <!-- ============================= -->
  <!-- Gazebo TurtleBot World -->
  <!-- ============================= -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">

    <arg name="world_name"
         value="$(find turtlebot3_gazebo)/worlds/turtlebot3_world.world"/>

    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>

  </include>

  <!-- ============================= -->
  <!-- Spawn Robot -->
  <!-- ============================= -->
  <node name="spawn_urdf"
        pkg="gazebo_ros"
        type="spawn_model"
        args="-urdf -model lmr1 -param robot_description -x 0.5 -y -0.5 -z 0.05"
        output="screen"/>

  <!-- ============================= -->
  <!-- Robot State Publisher -->
  <!-- ============================= -->
  <node name="robot_state_publisher"
        pkg="robot_state_publisher"
        type="robot_state_publisher"/>

  <!-- ============================= -->
  <!-- Map Server, AMCL, NavStack -->
  <!-- ============================= -->

  <node pkg="map_server"
        type="map_server"
        name="map_server"
        args="$(find lmr1_description)/maps/lmr1_gmapping_turtleworld.yaml"/>

  <include file="$(find amcl)/examples/amcl_diff.launch" />

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
        <rosparam file="$(find lmr1_description)/config/costmap_common_params.yaml" command="load" ns="global_costmap" /> 
        <rosparam file="$(find lmr1_description)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
        <rosparam file="$(find lmr1_description)/config/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find lmr1_description)/config/global_costmap_params.yaml" command="load" /> 
        <rosparam file="$(find lmr1_description)/config/base_local_planner_params.yaml" command="load" />

        <remap from="cmd_vel" to="/lmr1/cmd_vel"/>
  </node>

  <!-- ============================= -->
  <!-- RViz -->
  <!-- ============================= -->
  <node pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find lmr1_description)/rviz/nav_config.rviz"
        output="screen"/>

</launch>