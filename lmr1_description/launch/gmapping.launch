<launch>

  <!-- ============================= -->
  <!-- Use Gazebo Clock -->
  <!-- ============================= -->
  <param name="use_sim_time" value="true"/>

  <!-- ============================= -->
  <!-- Robot Description -->
  <!-- ============================= -->
  <param name="robot_description"
         command="$(find xacro)/xacro $(find lmr1_description)/urdf/robot.urdf.xacro"/>

  <!-- ============================= -->
  <!-- Gazebo TurtleBot World -->
  <!-- ============================= -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">

    <arg name="world_name"
         value="$(find turtlebot3_gazebo)/worlds/turtlebot3_world.world"/>

    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>

  </include>

  <!-- ============================= -->
  <!-- Spawn Robot -->
  <!-- ============================= -->
  <node name="spawn_urdf"
        pkg="gazebo_ros"
        type="spawn_model"
        args="-urdf -model lmr1 -param robot_description -x 0.5 -y -0.5 -z 0.05"
        output="screen"/>

  <!-- ============================= -->
  <!-- Robot State Publisher -->
  <!-- ============================= -->
  <node name="robot_state_publisher"
        pkg="robot_state_publisher"
        type="robot_state_publisher"/>

  <!-- ============================= -->
  <!-- GMapping SLAM -->
  <!-- ============================= -->
  <node pkg="gmapping"
        type="slam_gmapping"
        name="slam_gmapping"
        output="screen">

      <param name="base_frame" value="base_link"/>
      <param name="odom_frame" value="odom"/>

  </node>

  <!-- ============================= -->
  <!-- Keyboard Teleop -->
  <!-- ============================= -->
  <node pkg="teleop_twist_keyboard"
        type="teleop_twist_keyboard.py"
        name="teleop_twist_keyboard"
        output="screen"
        launch-prefix="xterm -fa 'Monospace' -fs 12 -e">

      <remap from="cmd_vel" to="/lmr1/cmd_vel"/>

  </node>

  <!-- ============================= -->
  <!-- RViz -->
  <!-- ============================= -->
  <node pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find lmr1_description)/rviz/config.rviz"
        output="screen"/>

</launch>